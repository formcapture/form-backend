    "@playwright/test": "^1.65.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@terrestris/eslint-config-typescript": "^10.0.0",
    "@terrestris/eslint-config-typescript-react": "^6.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",

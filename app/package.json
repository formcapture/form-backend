  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm run typecheck",
    "dev": "vite",
    "dev:build": "tsc -b && vite build --config vite.config.dev.ts --emptyOutDir",
    "lint": "eslint -c eslint.config.mjs src/**",
    "lint:fix": "eslint -c eslint.config.mjs src/** --fix",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest --config vite.config.dev.ts",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ag-grid-community/client-side-row-model": "^32.3.9",
    "@ag-grid-community/core": "^32.3.9",
    "@ag-grid-community/locale": "^36.1.0",

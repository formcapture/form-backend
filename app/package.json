{
  "name": "form-frontend",
  "version": "0.0.0-semantically-released",
  "private": true,
  "description": "A React webapp to to render dataview tables and forms.",
  "license": "BSD-2-Clause",
  "author": "terrestris GmbH & Co. KG <info@terrestris.de>",
  "contributors": [

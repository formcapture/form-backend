    "@ag-grid-community/styles": "^32.3.9",
    "@json-editor/json-editor": "^2.16.0",
    "@terrestris/base-util": "^4.0.2",
    "@testing-library/dom": "^10.4.1",
    "@types/geojson": "^7946.0.14",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.11.3",
    "dotenv": "^17.4.2",
    "i18next": "^26.0.8",
    "i18next-browser-languagedetector": "^8.2.1",
